{
	"name": "bot-login",
	"version": "1.0.0",
	"description": "",
	"main": "dist/index.js",
	"scripts": {
		"start": "npm run prod",
		"start:ts": "set NODE_ENV=production&& tsx src",
		"dev": "tsx watch src",
		"prod": "set NODE_ENV=production&&tsup src && node .",
		"build": "tsup src",
		"session:reset": "node scripts/reset-session.cjs",
		"test:stock": "tsup tests/stockApi.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/stockApi.test.js",
		"test:session": "tsup tests/sessionLogin.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/sessionLogin.test.js",
		"lint": "eslint --fix ./src",
		"test:telegram": "tsup tests/telegram.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/telegram.test.js",
		"test:compat": "tsup tests/whatsappCompatibility.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/whatsappCompatibility.test.js",
		"test:runtime": "tsup tests/runtimeLock.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/runtimeLock.test.js",
		"test:account": "tsup tests/accountSummary.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/accountSummary.test.js",
		"test:wallet": "tsup tests/telegramWallet.test.ts --target node20 --out-dir .test-build --clean && node --test .test-build/telegramWallet.test.js"
	},
	"keywords": [],
	"author": "NeguinDev",
	"license": "ISC",
	"private": true,
	"allowScripts": {
		"@prisma/client": true,
		"@prisma/engines": true,
		"prisma": true,
		"puppeteer": true,
		"esbuild": true
	},
	"tsup": {
		"clean": true,
		"bundle": true
	},
	"devDependencies": {
		"@types/node": "^20.5.1",
		"@typescript-eslint/eslint-plugin": "^6.4.1",
		"eslint": "^8.47.0",
		"eslint-config-standard-with-typescript": "^38.0.0",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-n": "^16.0.2",
		"eslint-plugin-promise": "^6.1.1",
		"tsup": "^7.2.0",
		"tsx": "^3.12.7",
		"typescript": "^5.1.6"
	},
	"dependencies": {
		"@prisma/client": "^5.1.1",
		"@types/mercadopago": "^1.5.8",
		"@types/qr-image": "^3.2.6",
		"@wppconnect-team/wppconnect": "2.3.6",
		"dotenv": "^16.3.1",
		"mercadopago": "^1.5.17",
		"prisma": "5.3.1",
		"qr-image": "^3.2.0"
	}
}
